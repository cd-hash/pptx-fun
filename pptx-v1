from pptx import Presentation

def copy_font_formatting(source_font, target_font):
    """Safely extracts and applies font formatting from one run to another."""
    target_font.name = source_font.name
    target_font.size = source_font.size
    target_font.bold = source_font.bold
    target_font.italic = source_font.italic
    target_font.underline = source_font.underline
    
    # Extracting color can be finicky depending on if it's an RGB or Theme color
    try:
        if source_font.color and source_font.color.type is not None:
            if hasattr(source_font.color, 'rgb') and source_font.color.rgb:
                target_font.color.rgb = source_font.color.rgb
            elif hasattr(source_font.color, 'theme_color'):
                target_font.color.theme_color = source_font.color.theme_color
    except AttributeError:
        pass # If color extraction fails, default to presentation theme

def process_text_frame(text_frame, replace_dict):
    """Attempts simple run-level replacement, falling back to advanced paragraph-level if needed."""
    for paragraph in text_frame.paragraphs:
        
        # Check if there are any keys to replace in this paragraph
        keys_in_paragraph = [key for key in replace_dict.keys() if key in paragraph.text]
        if not keys_in_paragraph:
            continue
            
        # STEP 1: The Simple Approach (Run-Level)
        # Try to find and replace the key intact within individual runs
        for run in paragraph.runs:
            for key in keys_in_paragraph:
                if key in run.text:
                    run.text = run.text.replace(key, str(replace_dict[key]))
                    
        # STEP 2: The Advanced Approach (Paragraph-Level Fallback)
        # If any key is STILL in paragraph.text, it means it was split across multiple runs
        remaining_keys = [key for key in keys_in_paragraph if key in paragraph.text]
        
        if remaining_keys and paragraph.runs:
            # Save the full paragraph text and apply all remaining replacements
            full_text = paragraph.text
            for key in remaining_keys:
                full_text = full_text.replace(key, str(replace_dict[key]))
                
            # Extract formatting from the very first run as our baseline
            reference_font = paragraph.runs[0].font
            
            # Save font attributes temporarily since clearing the paragraph destroys the reference
            font_kwargs = {
                'name': reference_font.name,
                'size': reference_font.size,
                'bold': reference_font.bold,
                'italic': reference_font.italic,
                'underline': reference_font.underline,
            }
            # Handle color safely before clearing
            color_rgb = None
            color_theme = None
            try:
                if reference_font.color and reference_font.color.type is not None:
                    if hasattr(reference_font.color, 'rgb') and reference_font.color.rgb:
                        color_rgb = reference_font.color.rgb
                    elif hasattr(reference_font.color, 'theme_color'):
                        color_theme = reference_font.color.theme_color
            except AttributeError:
                pass

            # Clear fragmented runs and rebuild as a single run
            paragraph.clear()
            new_run = paragraph.add_run()
            new_run.text = full_text
            
            # Apply saved formatting
            new_run.font.name = font_kwargs['name']
            new_run.font.size = font_kwargs['size']
            new_run.font.bold = font_kwargs['bold']
            new_run.font.italic = font_kwargs['italic']
            new_run.font.underline = font_kwargs['underline']
            
            if color_rgb:
                new_run.font.color.rgb = color_rgb
            elif color_theme:
                new_run.font.color.theme_color = color_theme

def process_shape(shape, replace_dict):
    """Routes the shape to the text processor depending on its type."""
    # Handle standard text boxes and shapes
    if shape.has_text_frame:
        process_text_frame(shape.text_frame, replace_dict)
        
    # Handle tables explicitly
    elif shape.has_table:
        for row in shape.table.rows:
            for cell in row.cells:
                process_text_frame(cell.text_frame, replace_dict)
                
    # Bonus: Handle grouped shapes (shapes inside of other shapes)
    elif hasattr(shape, 'shape_type') and shape.shape_type == 6: # 6 is MSO_SHAPE_TYPE.GROUP
        for sub_shape in shape.shapes:
            process_shape(sub_shape, replace_dict)

def build_presentation(template_path, output_path, replace_dict):
    """Main execution function."""
    prs = Presentation(template_path)

    for slide in prs.slides:
        for shape in slide.shapes:
            process_shape(shape, replace_dict)

    prs.save(output_path)
    print(f"Presentation successfully saved to {output_path}")
