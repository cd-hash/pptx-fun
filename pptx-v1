import pandas as pd
from pptx import Presentation


def get_slide_by_title(prs, target_title):
    """Finds a slide by its title text."""
    for slide in prs.slides:
        if slide.shapes.title and slide.shapes.title.has_text_frame:
            if slide.shapes.title.text_frame.text.strip() == target_title:
                return slide
        for shape in slide.shapes:
            if shape.has_text_frame and shape.text_frame.text.strip() == target_title:
                return slide
    return None

def write_to_cell_preserving_format(cell, value):
    """Writes text into a table cell while keeping its template font styles."""
    p = cell.text_frame.paragraphs[0]
    if p.runs:
        p.runs[0].text = str(value)
        for extra_run in p.runs[1:]:
            extra_run.text = ""
    else:
        cell.text = str(value)

def fill_table_from_df(slide, df, include_headers=True, start_row=0, start_col=0, table_name=None):
    """Finds a specific table on a slide and populates it with DataFrame contents."""
    table_shape = None
    
    # Locate the target table
    for shape in slide.shapes:
        if shape.has_table:
            if table_name:
                # Extract all text from the first row of this table to check for the name
                first_row_text = " ".join(cell.text_frame.text.strip() for cell in shape.table.rows[0].cells)
                if table_name in first_row_text:
                    table_shape = shape.table
                    break
            else:
                # Default to the first table found if no name is specified
                table_shape = shape.table
                break
            
    if not table_shape:
        target_str = f"named '{table_name}'" if table_name else ""
        print(f"Warning: No table {target_str} found on this slide.")
        return

    num_table_rows = len(table_shape.rows)
    num_table_cols = len(table_shape.columns)
    current_row = start_row

    if include_headers:
        if current_row < num_table_rows:
            for c_idx, col_name in enumerate(df.columns):
                target_col = start_col + c_idx
                if target_col < num_table_cols:
                    cell = table_shape.cell(current_row, target_col)
                    write_to_cell_preserving_format(cell, col_name)
            current_row += 1

    for r_idx, row_values in enumerate(df.values):
        if current_row >= num_table_rows:
            print(f"Warning: DataFrame exceeded available table rows at index {current_row}. Truncating.")
            break
            
        for c_idx, val in enumerate(row_values):
            target_col = start_col + c_idx
            if target_col < num_table_cols:
                cell = table_shape.cell(current_row, target_col)
                write_to_cell_preserving_format(cell, val)
        current_row += 1


def process_text_frame(text_frame, replace_dict):
    """Replaces text while preserving precise run-level formatting, even for split placeholders."""
    for paragraph in text_frame.paragraphs:
        for key, value in replace_dict.items():
            
            for run in paragraph.runs:
                if key in run.text:
                    run.text = run.text.replace(key, str(value))
            
            while key in paragraph.text:
                runs = paragraph.runs
                run_texts = [r.text for r in runs]
                full_text = "".join(run_texts)
                
                start_idx = full_text.find(key)
                if start_idx == -1:
                    break 
                    
                end_idx = start_idx + len(key)
                
                def get_run_and_offset(abs_idx):
                    current = 0
                    for i, run_text in enumerate(run_texts):
                        if current <= abs_idx < current + len(run_text):
                            return i, abs_idx - current
                        current += len(run_text)
                    return len(run_texts) - 1, len(run_texts[-1])
                
                start_run_idx, start_local = get_run_and_offset(start_idx)
                end_run_idx, end_local = get_run_and_offset(end_idx)
                
                runs[start_run_idx].text = run_texts[start_run_idx][:start_local] + str(value)
                
                for i in range(start_run_idx + 1, end_run_idx):
                    runs[i].text = ""
                    
                if start_run_idx != end_run_idx:
                    runs[end_run_idx].text = run_texts[end_run_idx][end_local:]
                else:
                    runs[start_run_idx].text += run_texts[end_run_idx][end_local:]

def process_shape(shape, replace_dict):
    """Routes the shape to the text processor depending on its type."""
    if shape.has_text_frame:
        process_text_frame(shape.text_frame, replace_dict)
    elif shape.has_table:
        for row in shape.table.rows:
            for cell in row.cells:
                process_text_frame(cell.text_frame, replace_dict)
    elif hasattr(shape, 'shape_type') and shape.shape_type == 6:
        for sub_shape in shape.shapes:
            process_shape(sub_shape, replace_dict)


def build_single_presentation(template_path, output_path, text_replace_dict, table_data_configs=None):
    """Processes a single presentation trial."""
    prs = Presentation(template_path)

    # 1. Handle all standard global text placeholders
    for slide in prs.slides:
        for shape in slide.shapes:
            process_shape(shape, text_replace_dict)

    # 2. Process specific table injections
    if table_data_configs:
        for config in table_data_configs:
            slide_title = config.get("slide_title")
            target_slide = get_slide_by_title(prs, slide_title)
            
            if target_slide:
                fill_table_from_df(
                    slide=target_slide,
                    df=config.get("dataframe"),
                    include_headers=config.get("include_headers", True),
                    start_row=config.get("start_row", 0),
                    start_col=config.get("start_col", 0),
                    table_name=config.get("table_name") # Targets specific table on the slide
                )
            else:
                print(f"Warning: Could not find a slide titled '{slide_title}' for output {output_path}")

    prs.save(output_path)
    print(f"Success: Saved {output_path}")

def run_batch_presentations(template_path, trials):
    """Iterates through a list of trial configurations to generate multiple presentations."""
    print(f"Starting batch job for {len(trials)} presentations...")
    for idx, trial in enumerate(trials, 1):
        print(f"Processing trial {idx}/{len(trials)}: {trial['output_path']}")
        
        build_single_presentation(
            template_path=template_path,
            output_path=trial["output_path"],
            text_replace_dict=trial.get("text_replace_dict", {}),
            table_data_configs=trial.get("table_data_configs", [])
        )
    print("Batch processing complete!")


